# 构建产物（可重建，不进版本库；也不进 FILELIST.txt）
01_ofx插件源码/out/
01_ofx插件源码/obj/
01_ofx插件源码/bundle/
installer/build/
**/__pycache__/
*.pyc

# install.bat 替换被占用 DLL 时留下的临时名
*.locked-*

# 验收工具：基线 raw 每次现生成，不入库（15 用例 x 2.6MB ≈ 41MB），
# 仓库里只留 baseline_manifest.txt（md5 清单）。
06_验收工具/*.raw

# 07_引擎资产：第三方 NamaSDK + AI 模型，约 138MB，可从 NamaSDK 重取得或在装机 bundle
# 里另取两份，不入库。但 stage.bat 要留 —— 它是这份资产的「放回 ProgramData」入口。
07_引擎资产/*
!07_引擎资产/stage.bat

# 源码里的临时备份（发版确认后应删除，不让 git status 一直挂着）
01_ofx插件源码/src/*.bak_*

# ---- 以下都是「跑一次就重新生成」的过程产物，2026-10-27 全量清理时确认 ----

